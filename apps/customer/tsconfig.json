{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "react-native",
		"lib": ["ES2022"],
		"strict": true,
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"**/*.ts",
		"**/*.tsx",
		".expo/types/**/*.d.ts",
		"expo-env.d.ts",
		"nativewind-env.d.ts",
		".expo/types/**/*.ts"
	],
	"exclude": ["node_modules", "dist", ".expo", "android", "ios"]
}
