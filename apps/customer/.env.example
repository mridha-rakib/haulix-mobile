# HAULIX Customer App — Environment Variables
# Copy to .env.local for development. Never commit .env.local or real credentials.

# ── Public (included in JS bundle — NO secrets) ──────────────────────────────
# EXPO_PUBLIC_ prefix is REQUIRED for client-side access.

# Backend API base URL (no trailing slash)
EXPO_PUBLIC_API_URL=https://api.dev.haulix.com

# App environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# ── EAS (build-time only — not in JS bundle) ─────────────────────────────────
# Set in EAS secrets panel or CI environment. Never put here.

# EAS project ID (created when registering via `eas init`)
# EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── NEVER PUT HERE ─────────────────────────────────────────────────────────────
# API secret keys, JWT signing secrets, Stripe secret keys,
# Firebase service account credentials, database passwords, etc.
# Those belong in backend environment variables ONLY.

