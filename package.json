{
  "name": "haulix-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "HAULIX Mobile — Monorepo for Customer and Driver/Helper applications",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:customer": "turbo run dev --filter=@haulix/customer",
    "dev:driver": "turbo run dev --filter=@haulix/driver",
    "dev:all": "turbo run dev --filter=@haulix/customer --filter=@haulix/driver --parallel",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "check:fix": "biome check . --write",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "clean": "turbo run clean && rimraf node_modules",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "2.6.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "babel-jest": "^29.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.3.0",
    "pngjs": "^7.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.15",
    "turbo": "2.11.10",
    "typescript": "^5.8.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
